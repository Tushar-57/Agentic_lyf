# AI Agent Ecosystem Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# LLM Provider Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama2

# LangSmith Configuration (optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ai-agent-ecosystem

# Database Configuration
FAISS_INDEX_PATH=./data/faiss_index
KNOWLEDGE_BASE_PATH=./data/knowledge_base.json
AGENTIC_DATA_DIR=./data

# Embedding chunking controls
EMBEDDING_MAX_CHARS_PER_CHUNK=1200
EMBEDDING_CHUNK_OVERLAP_CHARS=180
EMBEDDING_MAX_CHUNKS_PER_ENTRY=8

# Logging controls
LOG_LEVEL=INFO
LOG_COLOR_ENABLED=true
EMBEDDING_LOG_ENABLED=true
EMBEDDING_LOG_FULL_TEXT=true
EMBEDDING_LOG_MAX_TEXT_CHARS=32000
AI_CONVERSATION_LOG_ENABLED=true
AI_CONVERSATION_LOG_FULL_TEXT=true
AI_CONVERSATION_LOG_MAX_CHARS=64000

# Google Services Configuration (optional)
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json
GOOGLE_SHEETS_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false

# Telegram Bot Configuration (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ENABLED=false

# Security
SECRET_KEY=your-secret-key-change-in-production