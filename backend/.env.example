# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ENABLED=true
TELEGRAM_BOT_USERNAME=your_bot_username

# Optional: Webhook configuration (for production)
# TELEGRAM_USE_WEBHOOK=false
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook
# TELEGRAM_WEBHOOK_PORT=8443

# LLM Configuration (if not already set)
# OPENAI_API_KEY=your_openai_key_here
# or
# OLLAMA_BASE_URL=http://localhost:11434

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8088
# Optional wildcard support for preview domains
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app|https://.*\.netlify\.app
