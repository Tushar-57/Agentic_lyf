# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ENABLED=true
TELEGRAM_BOT_USERNAME=your_bot_username

# Optional: Webhook configuration (for production)
# TELEGRAM_USE_WEBHOOK=false
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook
# TELEGRAM_WEBHOOK_PORT=8443

# LLM Configuration (if not already set)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# or
# OLLAMA_BASE_URL=http://localhost:11434

# Persistent storage root (set this to a mounted disk path in production)
# AGENTIC_DATA_DIR=./data

# Embedding chunking controls
# EMBEDDING_MAX_CHARS_PER_CHUNK=1200
# EMBEDDING_CHUNK_OVERLAP_CHARS=180
# EMBEDDING_MAX_CHUNKS_PER_ENTRY=8

# Logging controls (recommended for deployment troubleshooting)
# LOG_LEVEL=INFO
# LOG_COLOR_ENABLED=true
# EMBEDDING_LOG_ENABLED=true
# EMBEDDING_LOG_FULL_TEXT=true
# EMBEDDING_LOG_MAX_TEXT_CHARS=32000
# AI_CONVERSATION_LOG_ENABLED=true
# AI_CONVERSATION_LOG_FULL_TEXT=true
# AI_CONVERSATION_LOG_MAX_CHARS=64000

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8088
# Optional wildcard support for preview domains
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app|https://.*\.netlify\.app
